# ── Application ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values. NEVER commit .env.

DATABASE_URL=postgresql://raguser:ragpass@db:5432/financerag
# Local, no-API-billing setup. Install Ollama on the host and pull the models
# listed in README.md. The backend container reaches Ollama via host.docker.internal.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=llama3.2:3b

# Optional hosted alternative. Set AI_PROVIDER=openai and add a funded API key.
# OPENAI_API_KEY=

# Optional — controls log level (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO
